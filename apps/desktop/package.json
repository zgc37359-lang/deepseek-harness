{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.0-rc.12",
  "private": true,
  "description": "Windows desktop application shell over the DeepSeek Harness web UI",
  "author": "DeepSeek AI",
  "type": "module",
  "main": "lib/types/main.js",
  "build": {
    "appId": "com.deepseek-ai.dsh-desktop",
    "productName": "Harness Desktop",
    "directories": {
      "output": "dist-app"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "lib/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "dsh-desktop-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "zgc37359-lang",
      "repo": "harness-desktop"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:preload && pnpm run build:renderer",
    "build:ts": "tsc -b tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc -b tsconfig.json",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "probe:pty": "electron . --pty-probe",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "perf:test": "node scripts/perf-test.mjs",
    "soak:test": "node scripts/soak-test.mjs",
    "bench:stream": "node scripts/bench-stream.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "e2e:window": "node scripts/e2e-window.mjs",
    "install:cycle": "node scripts/install-cycle.mjs",
    "dist": "pnpm run build && electron-builder --win nsis",
    "dist:flat": "node scripts/flatten-deps.mjs && node node_modules/electron-builder/cli.js --win nsis --config electron-builder.flat.yml"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-agent-tool-presentation": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-desktop-host": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-grants": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-output-retention": "workspace:^",
    "@deepseek-ai/dsh-persona": "workspace:^",
    "@deepseek-ai/dsh-pwsh-local": "workspace:^",
    "@deepseek-ai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-terminal-bash": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:^",
    "@deepseek-ai/dsh-tool-bash-persistent": "workspace:^",
    "@deepseek-ai/dsh-tool-cordis": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "node-addon-require-builtin": "^0.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
